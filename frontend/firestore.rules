rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    match /doctors/{doctorId} {
      allow get: if signedIn() && (request.auth.uid == doctorId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == doctorId
        && request.resource.data.uid == doctorId
        && !('role' in request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == doctorId
        && request.resource.data.get('uid', doctorId) == resource.data.get('uid', doctorId)
        && request.resource.data.get('role', 'doctor') == resource.data.get('role', 'doctor');
    }

    match /appointments/{appointmentId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.doctorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.doctorId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.doctorId == request.auth.uid
        && request.resource.data.doctorId == request.auth.uid;
    }

    match /bills/{billId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.doctorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.doctorId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.doctorId == request.auth.uid
        && request.resource.data.doctorId == request.auth.uid;
    }

    match /counters/bills {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq'])
        && request.resource.data.seq == resource.data.seq + 1;
    }
  }
}
